{
  "name": "ai-project-tracker",
  "version": "1.4.4",
  "description": "Real-time project progress tracker for AI coding tools (opencode, Claude Code, Cursor, VS Code Copilot, web AI): 7 phases, percentages, growth charts, ETA, milestones, bilingual EN/FA dashboard. Zero npm dependencies, 100% local. Includes MCP server, Claude Code hooks, CLI and git-history import.",
  "type": "module",
  "bin": {
    "pt": "cli/pt.mjs"
  },
  "main": "./project-tracker.ts",
  "exports": {
    ".": "./project-tracker.ts",
    "./core": "./core/tracker-core.mjs",
    "./mcp": "./mcp/server.mjs",
    "./cli": "./cli/pt.mjs",
    "./plugin": "./project-tracker.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "next"
  },
  "files": [
    "core/",
    "cli/",
    "mcp/",
    "hooks/",
    "web/",
    "docs/",
    "claude-commands/",
    "project-tracker.ts",
    "README.md",
    "README.fa.md",
    "CHANGELOG.md",
    "LICENSE",
    "!core/test-core.mjs",
    "!mcp/test-mcp.mjs",
    "!hooks/claude-code/test-hook.mjs"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "claude-code",
    "mcp",
    "project-tracker",
    "progress",
    "dashboard",
    "charts",
    "eta",
    "milestones",
    "tracking"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Helixventures-AI/ai-project-tracker.git"
  },
  "homepage": "https://github.com/Helixventures-AI/ai-project-tracker",
  "bugs": {
    "url": "https://github.com/Helixventures-AI/ai-project-tracker/issues"
  }
}
